---
import SiteHead from '../components/SiteHead.astro';
---
<!doctype html>
<html lang="en">
<head>
  <SiteHead />
  <title>Page Not Found — Abraham Zhong</title>
  <meta name="robots" content="noindex">
</head>
<body style="background:#0000aa">
  <main class="bsod">
    <div class="bsod-inner">
      <p class="bsod-title"><span>ABRAHAM ZHONG</span></p>
      <p>A fatal exception has occurred: the page you requested could not be found.</p>
      <p class="bsod-code">PAGE_NOT_FOUND (404)</p>
      <p>* Check the address for typos.<br>* Or head back to the desktop.</p>
      <p><a href="/" class="bsod-restart">Press here to go back outside<span class="cursor">_</span></a></p>
    </div>
  </main>
</body>
</html>
