---
// Page shell (title bar, back links, shared head) lives in src/layouts/ProjectLayout.astro.
// title: the heading and browser tab. description: the line search results and link previews show.
import ProjectLayout from '../../layouts/ProjectLayout.astro';
---
<ProjectLayout
  slug="voron"
  windowTitle="Voron.exe"
  title="Voron 0.2 3D Printer"
  description="A compact CoreXY 3D printer I tuned to print faster and quieter by tinkering with its controls and firmware."
>
  <p class="lede">A compact CoreXY 3D printer I tuned to print faster and quieter by tinkering with its controls and firmware.</p>

  {/* Photos, full size, top to bottom. To add one: put a "gallery voron/<name> <file>" line in
       scripts/optimize-media.sh, run it, then copy a <figure> line below (width/height/--r come from the image size). */}
  <div class="photos">
    <figure><video class="play-once" src="/media/voron-02-3d-printer.mp4" poster="/media/voron-02-3d-printer.webp" style="--r:1.7778" muted playsinline controls preload="metadata" aria-label="Voron 0.2 3D Printer video"></video></figure>
    <figure><img src="/media/voron/printer.webp" alt="The finished printer" width="1199" height="1600" style="--r:0.7494" loading="lazy" decoding="async"><figcaption>The finished printer</figcaption></figure>
    <figure><img src="/media/voron/left-belts.webp" alt="Left belt path" width="1600" height="1200" style="--r:1.3333" loading="lazy" decoding="async"><figcaption>Left belt path</figcaption></figure>
    <figure><img src="/media/voron/right-belts.webp" alt="Right belt path" width="1600" height="1200" style="--r:1.3333" loading="lazy" decoding="async"><figcaption>Right belt path</figcaption></figure>
    <figure><img src="/media/voron/side-belt.webp" alt="Side belt view" width="1600" height="1200" style="--r:1.3333" loading="lazy" decoding="async"><figcaption>Side belt view</figcaption></figure>
  </div>

  {/* Descriptions (coming later). Starter sections to paste above the photos:
  <section>
    <h2>Overview</h2>
    <p>What this project is and why you built it.</p>
  </section>
  <section>
    <h2>How it works</h2>
    <p>The main parts (hardware, software) and how they fit together.</p>
  </section>
  <section>
    <h2>What I learned</h2>
    <p>The hardest problem you hit and how you solved it.</p>
  </section>
  */}
</ProjectLayout>
