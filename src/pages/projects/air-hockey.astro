---
// Page shell (title bar, back links, shared head) lives in src/layouts/ProjectLayout.astro.
// title: the heading and browser tab. description: the line search results and link previews show.
import ProjectLayout from '../../layouts/ProjectLayout.astro';
---
<ProjectLayout
  slug="air-hockey"
  windowTitle="AirHockey.exe"
  title="Robotic Air Hockey Table"
  description="A segmentation pipeline that analyzes air hockey footage to track the puck and its path."
>
  <p class="lede">A segmentation pipeline that analyzes air hockey footage to track the puck and its path.</p>

  {/* Photos, full size, top to bottom. To add one: put a "gallery air-hockey/<name> <file>" line in
       scripts/optimize-media.sh, run it, then copy a <figure> line below (width/height/--r come from the image size). */}
  <div class="photos">
    <figure><video class="play-once" src="/media/robotic-air-hockey-table.mp4" poster="/media/robotic-air-hockey-table.webp" style="--r:1.7778" muted playsinline controls preload="metadata" aria-label="Robotic Air Hockey Table video"></video></figure>
  </div>

  <p class="muted">More photos coming soon.</p>

