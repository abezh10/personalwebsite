---
// Shell for every page in src/pages/projects: shared head, the window title bar with its close button,
// the heading, and the "Back to projects" links. Each page fills in the photos (the slot below).
import SiteHead from '../components/SiteHead.astro';

interface Props {
  slug: string;
  windowTitle: string;
  title: string;
  description: string;
}
const { slug, windowTitle, title, description } = Astro.props;
const pageTitle = `${title} · Abraham Zhong`;
const url = `https://abrahamzhong.com/projects/${slug}`;
---
<!doctype html>
<html lang="en">
<head>
  <SiteHead />
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url}>
  <meta property="og:type" content="article">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
</head>
<body class="project-page">
  <article class="window project-win">
    <div class="title-bar">
      <span class="title">{windowTitle}</span>
      <div class="title-buttons">
        <a href="/#projects" data-home data-act="close" aria-label="Close and go back to projects"><svg viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><path d="M0 0h2v1h1v1h2V1h1V0h2v2H7v1H6v2h1v1h1v2H6V7H5V6H3v1H2v1H0V6h1V5h1V3H1V2H0z"/></svg></a>
      </div>
    </div>

    <div class="window-body project-body">
      <a href="/#projects" class="back-link" data-home>&larr; Back to projects</a>
      <h1>{title}</h1>
      <slot />
      <a href="/#projects" class="px-btn small back-btn" data-home>&larr; Back to projects</a>
    </div>
  </article>

  <script>import '../scripts/project.js';</script>
</body>
</html>
